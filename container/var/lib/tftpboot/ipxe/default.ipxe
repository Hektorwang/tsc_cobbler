#!ipxe

set menu-timeout 20000
set submenu-timeout ${menu-timeout}

# Set Menu Default to Exit after timeout
isset ${menu-default} || set menu-default local

:Cobbler
menu Cobbler | https://cobbler.github.io
item local (local)
item Euler-x86_64 Euler-x86_64
choose --default ${menu-default} --timeout ${menu-timeout} target && goto ${target}


:Euler-x86_64
kernel /images/Euler-x86_64/vmlinuz   inst.ks.sendmac inst.ks=http://192.168.100.1/cblr/svc/op/autoinstall/profile/Euler-x86_64 inst.repo=http://192.168.100.1/Euler-x86_64/ initrd=initrd.magic
initrd /images/Euler-x86_64/initrd.img
boot


:local
iseq ${smbios/manufacturer} HP && exit ||
sanboot --no-describe --drive 0x80
